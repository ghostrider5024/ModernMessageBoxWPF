<Window
    x:Class="Demo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Demo"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="800"
    Height="450"
    mc:Ignorable="d">
    <Window.Resources>
        <Style x:Key="CancelButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Red" />
        </Style>
    </Window.Resources>

    <StackPanel>
        <Button Click="Button_Click">Info</Button>
        <Button Click="Button_Click_1">Success</Button>
        <Button Click="Button_Click_2">Warning</Button>
        <Button Click="Button_Click_3">Error</Button>
        <Button Click="Button_Click_4">Input Text</Button>
        <Button Click="Button_Click_5">Input Password</Button>
    </StackPanel>
</Window>
